<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Which way the phone is moving: walking, still, in a vehicle. Not where. -->
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
  <!-- The watch is lost on reboot and on update, and put back from these. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <receiver android:name="gr.carpool.drivedetect.VehicleReceiver" android:exported="false" />
    <receiver android:name="gr.carpool.drivedetect.RestoreReceiver" android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
