# Copy to .env and adjust. Never commit .env.

# --- required ---
DATABASE_URL=postgres://carpool:carpool@localhost:5433/carpool?sslmode=disable
# Must be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-bytes-of-random

# --- optional, shown with their defaults ---
OSRM_URL=http://localhost:5000
HTTP_ADDR=:8080

# DEV_MODE prints the OTP to the console instead of sending an SMS.
# It must never be true in production.
DEV_MODE=false

# Stamped onto stored routes so a map-data swap can trigger re-snapping.
OSRM_DATA_VERSION=greece-2026-07-29-evros-buffered

# --- production only (docker-compose.yml) ---
# The domain Caddy will obtain a TLS certificate for.
DOMAIN=carpool.example.gr
POSTGRES_PASSWORD=change-me
# Basename of the OSRM artifacts under ./osrm-data (without .osrm).
OSRM_EXTRACT=evros-buffered
# Region boundary seeded at boot; the path is inside the API container.
REGION_FIXTURE=/fixtures/regions/evros.geojson
FUEL_PRICE_EUR=1.800

# The SMS gateway one-time codes go through. Leave SMS_URL empty and set
# DEV_MODE=true to print codes to the log instead. The body template is
# configuration because the Greek gateways quote rather than publish, so the
# provider is chosen on price and only its field names differ.
SMS_URL=
SMS_TOKEN=
SMS_SENDER=CARPOOL
# SMS_TEMPLATE={"sender":"{{sender}}","recipient":"{{phone}}","text":"{{message}}"}

# INVITE_ONLY makes a NEW account require a code somebody handed out. Existing
# accounts sign in unaffected, so it can be switched on mid-pilot. Seed the
# first codes by hand:
#   INSERT INTO invite_codes (code, max_uses) VALUES ('EVROS001', 20);
INVITE_ONLY=false

# PUBLIC_BASE_URL is the address route links are built on: a driver sharing a
# route sends https://<this>/r/<token>. Empty means the share is the sentence
# alone. INSTALL_URL is where that page sends somebody without the app; only
# an https address is ever shown.
PUBLIC_BASE_URL=
INSTALL_URL=
# INSTALL_REDIRECT is the store or APK link that https://<DOMAIN>/get redirects
# to. Set INSTALL_URL=https://<DOMAIN>/get and the install taps from route links
# show up in Caddy's log, where specs/NEXT.md experiment B counts them.
INSTALL_REDIRECT=
