# Copy to .env and adjust. Never commit .env.

# --- required ---
DATABASE_URL=postgres://carpool:carpool@localhost:5433/carpool?sslmode=disable
# Must be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-bytes-of-random

# --- optional, shown with their defaults ---
OSRM_URL=http://localhost:5000
HTTP_ADDR=:8080

# DEV_MODE prints the OTP to the console instead of sending an SMS.
# It must never be true in production.
DEV_MODE=false

# Stamped onto stored routes so a map-data swap can trigger re-snapping.
OSRM_DATA_VERSION=greece-2026-07-29-evros-buffered

# --- production only (docker-compose.yml) ---
# The domain Caddy will obtain a TLS certificate for.
DOMAIN=carpool.example.gr
POSTGRES_PASSWORD=change-me
# Basename of the OSRM artifacts under ./osrm-data (without .osrm).
OSRM_EXTRACT=evros-buffered
# Region boundary seeded at boot; the path is inside the API container.
REGION_FIXTURE=/fixtures/regions/evros.geojson
FUEL_PRICE_EUR=1.800
