# Caddy terminates TLS and proxies to the API. Certificates are obtained and
# renewed automatically from Let's Encrypt.

{$DOMAIN} {
	encode zstd gzip

	# The WebSocket upgrade needs no special handling in Caddy v2; reverse_proxy
	# passes it through.
	reverse_proxy api:8080 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format console
	}
}
